<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_subscription_management">
        <field name="name">Subscriptions</field>
        <field name="description">Helps you handle subscriptions and recurring invoicing.</field>
        <field name="sequence">3</field>
    </record>

    <!-- Subscription Groups -->
    <record id="group_subscription_user" model="res.groups">
        <field name="name">Subscription User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_subscription_management"/>
        <field name="comment">User can view and work with subscriptions</field>
    </record>

    <record id="group_subscription_manager" model="res.groups">
        <field name="name">Subscription Manager</field>
        <field name="category_id" ref="module_category_subscription_management"/>
        <field name="comment">Manager can manage subscriptions, plans and pricing</field>
        <field name="implied_ids" eval="[(4, ref('group_subscription_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Subscription multi-company -->
    <record model="ir.rule" id="solt_subscription_multicompany">
        <field name="name">Subscription multi-company</field>
        <field name="model_id" ref="model_solt_subscription"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="solt_recurring_plan_rule_company" model="ir.rule">
        <field name="name">Subscription Plan multi-company</field>
        <field name="model_id" ref="model_solt_recurring_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="solt_recurring_pricing_rule_company" model="ir.rule">
        <field name="name">Subscription Pricing multi-company</field>
        <field name="model_id" ref="model_solt_recurring_pricing"/>
        <field name="domain_force">[('company_id', 'in', [False] + company_ids)]</field>
    </record>

    <!-- Mail activity plans -->
    <record id="mail_plan_rule_group_sale_manager_subscription" model="ir.rule">
        <field name="name">Manager can manage subscription plans</field>
        <field name="groups" eval="[(4, ref('solt_recurring_payment.group_subscription_user'))]"/>
        <field name="model_id" ref="mail.model_mail_activity_plan"/>
        <field name="domain_force">[('res_model', '=', 'solt.subscription')]</field>
        <field name="perm_read" eval="False"/>
    </record>

    <record id="mail_plan_templates_rule_group_sale_manager_subscription" model="ir.rule">
        <field name="name">Manager can manage subscription plan templates</field>
        <field name="groups" eval="[(4, ref('solt_recurring_payment.group_subscription_user'))]"/>
        <field name="model_id" ref="mail.model_mail_activity_plan_template"/>
        <field name="domain_force">[('plan_id.res_model', '=', 'solt.subscription')]</field>
        <field name="perm_read" eval="False"/>
    </record>
</odoo>
