<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="res_partner_view_inherit_solt_recurring">
        <field name="name">partner.view.button.subscriptions_count</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="solt_base_entities.view_partner_entities_form"/>
        <field name="priority" eval="5"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object"
                        groups="solt_recurring_payment.group_subscription_user"
                        invisible="not subscription_count"
                        name="open_related_subscription" icon="fa-refresh">
                    <field string="Subscriptions" name="subscription_count" widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
