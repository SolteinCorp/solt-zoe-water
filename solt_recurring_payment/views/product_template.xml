<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_search_view_inherit_sale_subscription" model="ir.ui.view">
        <field name="name">product.template.search.inherit</field>
        <field name="model">product.template</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <filter name="filter_to_sell" position="after">
                <filter name="filter_recurring" string="Can be Recurring"
                        domain="[('recurring_ok', '=', True)]"/>
            </filter>
        </field>
    </record>

    <record id="product_template_view_form_recurring" model="ir.ui.view">
        <field name="name">solt.subscription.product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div name="options" position="inside">
                <span class="d-inline-flex">
                    <field name="recurring_ok"/>
                    <label for="recurring_ok" string="Recurring"/>
                </span>
            </div>
            <!-- Pass recurring_ok context so supplierinfo form shows plan_id field -->
            <xpath expr="//page[@name='purchase']//field[@name='seller_ids']" position="attributes">
                <attribute name="context">{'default_product_tmpl_id': id, 'product_template_invisible_variant': True, 'recurring_ok': recurring_ok}</attribute>
            </xpath>
            <xpath expr="//page[@name='purchase']//field[@name='variant_seller_ids']" position="attributes">
                <attribute name="context">{'model': 'product.template', 'recurring_ok': recurring_ok}</attribute>
            </xpath>
            <page name="sales" position="after">
                <page string="Recurring Prices" name="subscription_pricing" invisible="not recurring_ok or not sale_ok">
                    <field name="product_subscription_pricing_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <control>
                                <create name="add_product_pricing" string="Add a price rule"/>
                            </control>
                            <field name="product_variant_ids" widget="many2many_tags"
                                   optional="show"
                                   groups="product.group_product_variant"
                                   domain="[('product_tmpl_id', '=', parent.id)]"
                                   column_invisible="parent.product_variant_count &lt; 2"/>
                            <field name="plan_id"/>
                            <field name="required_recurring_quantity" optional="show"/>
                            <field name="free_periods" optional="show"/>
                            <field name="pricelist_id" groups="product.group_product_pricelist" optional="show"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="price"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <!-- Pass recurring_ok context in product.product form so supplierinfo shows plan_id -->
    <record id="view_product_product_supplier_inherit_recurring" model="ir.ui.view">
        <field name="name">product.product.form.recurring</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="seller_ids" position="attributes">
                <attribute name="context">{'default_product_tmpl_id': product_tmpl_id, 'product_template_invisible_variant': True, 'recurring_ok': recurring_ok}</attribute>
            </field>
            <field name="variant_seller_ids" position="attributes">
                <attribute name="context">{'model': 'product.product', 'active_id': id, 'recurring_ok': recurring_ok}</attribute>
            </field>
        </field>
    </record>

    <record id="product_action_subscription" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="context">{'default_recurring_ok': True, 'search_default_filter_recurring': True, 'default_detailed_type': 'service'}</field>
        <field name="search_view_id" ref="product_template_search_view_inherit_sale_subscription"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new product
            </p>
            <p>
                You must define a product for everything you sell or purchase,
                whether it's a storable product, a consumable or a service.
            </p>
        </field>
    </record>

</odoo>
