<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_pricelist_item_form_view_inherit_recurring" model="ir.ui.view">
        <field name="name">product.pricelist.item.form.inherit.recurring</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <field name="min_quantity" position="after">
                <field name="plan_id" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="product_pricelist_item_tree_view_from_product_inherit_recurring" model="ir.ui.view">
        <field name="name">product.pricelist.item.list.from.product.inherit.recurring</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_tree_view_from_product"/>
        <field name="arch" type="xml">
            <field name="min_quantity" position="after">
                <field name="plan_id" optional="show" options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>
