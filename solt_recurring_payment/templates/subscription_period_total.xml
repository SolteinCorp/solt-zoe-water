<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="subscription_period_total" name="Subscription Period Total">
        <t t-set="doc" t-value="o or sale_order or doc"/>
        <t t-set="totals" t-value="doc.subscription_period_total"/>
        <tr class="o_subscription_period_total" style="text-align: right; width: 100%; border-top: 1px solid #000 !important;">
            <td style="padding: 10px 0 0 0 !important; border: 0 !important; vertical-align: top;">
                <table style="margin-left: auto;">
                    <tbody>
                        <tr>
                            <td class="o_td_label" colspan="2" style="text-align: right !important; padding: 0 !important; border: 0 !important; vertical-align: top;">
                                <label class="o_form_label bold" style="border-top: 2pxmargin-right: 0; min-width: 0; white-space: nowrap; font-weight: bold;">Subscriptions</label>
                            </td>
                        </tr>
                        <t t-foreach="totals['plans']" t-as="plan" t-key="plan['id']">
                            <tr>
                                <td class="o_td_label" style="padding: 0 !important; border: 0 !important; vertical-align: top;">
                                    <label class="o_form_label bold" t-out="plan['plan_name']" style="padding-right: 20px; margin-right: 0; min-width: 0; white-space: nowrap; font-weight: bold;"/>
                                </td>
                                <td class="o_list_monetary" style="padding: 0 !important; border: 0 !important; vertical-align: top;">
                                </td>
                            </tr>
                            <tr>
                                <td class="o_td_label" style="padding: 0 !important; border: 0 !important; vertical-align: top;">
                                    <label class="o_form_label" style="padding-right: 20px; margin-right: 0; min-width: 0; white-space: nowrap;">Subtotal:</label>
                                </td>
                                <td class="o_list_monetary" style="padding: 0 !important; border: 0 !important; vertical-align: top;">
                                    <span name="formatted_periodic_amount" style="white-space: nowrap !important; font-weight: bold !important;"
                                          class="bold"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"
                                          t-out="plan['periodic_amount']"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="o_td_label" style="padding: 0 !important; border: 0 !important; vertical-align: top;">
                                    <label class="o_form_label" style="padding-right: 20px; margin-right: 0; min-width: 0; white-space: nowrap;">Taxes:</label>
                                </td>
                                <td class="o_list_monetary" style="padding: 0 !important; border: 0 !important; vertical-align: top;">
                                    <span name="formatted_periodic_tax_amount" style="white-space: nowrap !important; font-weight: bold !important;"
                                          class="bold"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"
                                          t-out="plan['periodic_tax_amount']"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="o_td_label" style="padding: 0 !important; border: 0 !important; vertical-align: top;">
                                    <label class="o_form_label bold" style="padding-right: 20px; margin-right: 0; min-width: 0; white-space: nowrap; font-weight: bold;">Total:</label>
                                </td>
                                <td class="o_list_monetary" style="padding: 0 !important; border: 0 !important; vertical-align: top; border-top: 1px solid #000 !important;">
                                    <span name="formatted_period_total" style="white-space: nowrap !important; font-weight: bold !important;"
                                          class="oe_subtotal_footer_separator bold"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"
                                          t-out="plan['period_total']"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </td>
            <td style="padding: 10px 0 0 0 !important; border: 0 !important; vertical-align: top;">
                <table style="margin-left: auto;">
                    <tbody>
                        <tr>
                            <td class="o_td_label" colspan="2" style="text-align: right !important; padding: 0 !important; border: 0 !important; vertical-align: top;">
                                <label class="o_form_label bold" style="border-top: 2px;margin-right: 0; min-width: 0; white-space: nowrap; font-weight: bold;">Products/Services</label>
                            </td>
                        </tr>
                        <tr>
                            <td class="o_td_label" style="padding: 0 !important; border: 0 !important; vertical-align: top;">
                                <label class="o_form_label" style="padding-right: 20px; margin-right: 0; min-width: 0; white-space: nowrap;">Subtotal:</label>
                            </td>
                            <td class="o_list_monetary" style="padding: 0 !important; border: 0 !important; vertical-align: top;">
                                <span name="formatted_amount_non_subscription" style="white-space: nowrap !important; font-weight: bold !important;"
                                      class="bold"
                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"
                                      t-out="totals['amount_non_subscription']"/>
                            </td>
                        </tr>
                        <tr>
                            <td class="o_td_label" style="padding: 0 !important; border: 0 !important; vertical-align: top;">
                                <label class="o_form_label" style="padding-right: 20px; margin-right: 0; min-width: 0; white-space: nowrap;">Taxes:</label>
                            </td>
                            <td class="o_list_monetary" style="padding: 0 !important; border: 0 !important; vertical-align: top;">
                                <span name="formatted_amount_tax_non_subscription" style="white-space: nowrap !important; font-weight: bold !important;"
                                      class="bold"
                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"
                                      t-out="totals['amount_tax_non_subscription']"/>
                            </td>
                        </tr>
                        <tr>
                            <td class="o_td_label" style="padding: 0 !important; border: 0 !important; vertical-align: top;">
                                <label class="o_form_label bold" style="padding-right: 20px; margin-right: 0; min-width: 0; white-space: nowrap; font-weight: bold;">Total:</label>
                            </td>
                            <td class="o_list_monetary" style="padding: 0 !important; border: 0 !important; vertical-align: top; border-top: 1px solid #000 !important;">
                                <span name="formatted_amount_total_non_subscription" style="white-space: nowrap !important; font-weight: bold !important;"
                                      class="oe_subtotal_footer_separator bold"
                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"
                                      t-out="totals['amount_total_non_subscription']"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
        <tr class="o_subscription_period_total" style="text-align: right; width: 100%; border-top: 1px solid #000 !important;">
            <td style="padding: 10px 0 0 0 !important; border: 0 !important; vertical-align: top;">
            </td>
            <td style="padding: 10px 0 0 0 !important; border: 0 !important; vertical-align: top;">
                <table style="margin-left: auto;">
                    <tbody>
                        <tr>
                            <td class="o_td_label" colspan="2" style="text-align: right !important; padding: 0 !important; border: 0 !important; vertical-align: top;">
                                <label class="o_form_label bold" style="border-top: 2px;margin-right: 0; min-width: 0; white-space: nowrap; font-weight: bold;">Final offer</label>
                            </td>
                        </tr>
                        <tr>
                            <td class="o_td_label" style="padding: 0 !important; border: 0 !important; vertical-align: top;">
                                <label class="o_form_label" style="padding-right: 20px; margin-right: 0; min-width: 0; white-space: nowrap;">Subtotal:</label>
                            </td>
                            <td class="o_list_monetary" style="padding: 0 !important; border: 0 !important; vertical-align: top;">
                                <span name="formatted_amount_subscription_subtotal" style="white-space: nowrap !important; font-weight: bold !important;"
                                      class="bold"
                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"
                                      t-out="totals['amount_subscription_subtotal']"/>
                            </td>
                        </tr>
                        <tr>
                            <td class="o_td_label" style="padding: 0 !important; border: 0 !important; vertical-align: top;">
                                <label class="o_form_label" style="padding-right: 20px; margin-right: 0; min-width: 0; white-space: nowrap;">Taxes:</label>
                            </td>
                            <td class="o_list_monetary" style="padding: 0 !important; border: 0 !important; vertical-align: top;">
                                <span name="formatted_amount_subscription_tax" style="white-space: nowrap !important; font-weight: bold !important;"
                                      class="bold"
                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"
                                      t-out="totals['amount_subscription_tax']"/>
                            </td>
                        </tr>
                        <tr>
                            <td class="o_td_label" style="padding: 0 !important; border: 0 !important; vertical-align: top;">
                                <label class="o_form_label bold" style="padding-right: 20px; margin-right: 0; min-width: 0; white-space: nowrap; font-weight: bold;">Total:</label>
                            </td>
                            <td class="o_list_monetary" style="padding: 0 !important; border: 0 !important; vertical-align: top; border-top: 1px solid #000 !important;">
                                <span name="formatted_amount_subscription_total" style="white-space: nowrap !important; font-weight: bold !important;"
                                      class="oe_subtotal_footer_separator bold"
                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"
                                      t-out="totals['amount_subscription_total']"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </template>
</odoo>
