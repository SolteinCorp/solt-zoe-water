<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Rich-content label for a plan option (strikethrough + badge + prepaid
         breakdown survive). -->
    <t t-name="website_solt_sale_recurring_payment.PlanOptionLabel">
        <span class="o_plan_name"><t t-esc="pricing.table_name"/>: </span>
        <span t-if="pricing.has_discount" class="text-decoration-line-through text-muted me-1">
            <t t-esc="pricing.table_list_price"/>
        </span>
        <span class="fw-bold"><t t-esc="pricing.table_price"/></span>
        <span t-if="pricing.has_discount and pricing.list_price_value &gt; 0"
              class="badge text-bg-danger ms-1">
            -<t t-esc="Math.round((1 - pricing.price_value / pricing.list_price_value) * 100)"/>%
        </span>
        <span t-if="pricing.breakdown" class="ms-2 text-muted small">
            (<t t-esc="pricing.breakdown"/>)
        </span>
    </t>

    <!-- Custom Bootstrap dropdown replacing the native <select> so each
         option can render rich HTML (strikethrough, badge, etc). -->
    <div t-name="website_solt_sale_recurring_payment.SubscriptionPricingSelect">
        <div t-if="combination_info.pricings and combination_info.subscription_pricing_select"
             class="o_subscription_plan_dropdown dropdown">
            <input type="hidden" name="plan_id" class="plan_select"
                   t-att-value="combination_info.subscription_default_pricing_plan_id"/>
            <button class="btn btn-light dropdown-toggle border w-100 text-start fs-5 o_plan_select_toggle"
                    type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="o_plan_label">
                    <t t-foreach="combination_info.pricings" t-as="pricing" t-key="pricing.plan_id">
                        <t t-if="pricing.plan_id == combination_info.subscription_default_pricing_plan_id">
                            <t t-call="website_solt_sale_recurring_payment.PlanOptionLabel"/>
                        </t>
                    </t>
                </span>
            </button>
            <ul class="dropdown-menu o_plan_dropdown_menu"
                style="min-width: 100%; width: max-content; max-width: min(90vw, 600px);">
                <t t-foreach="combination_info.pricings" t-as="pricing" t-key="pricing.plan_id">
                    <li>
                        <button type="button" class="dropdown-item o_plan_option text-wrap"
                                t-att-data-plan-id="pricing.plan_id">
                            <t t-call="website_solt_sale_recurring_payment.PlanOptionLabel"/>
                        </button>
                    </li>
                </t>
            </ul>
        </div>
        <h5 t-else="combination_info.pricings" class="no_plan_select">
            <span class="o_subscription_price"><t t-esc="combination_info.subscription_default_pricing_price"/>&#160;</span>
            <del t-if="combination_info.compare_list_price and (combination_info.compare_list_price &gt; combination_info.price) and combination_info.formated_compared_price">
                <bdi dir="inherit">
                    <span t-esc="combination_info.formated_compared_price"/>
                </bdi>
            </del>
        </h5>
    </div>

</templates>
