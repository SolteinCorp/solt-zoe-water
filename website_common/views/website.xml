<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_form_inherit_upload_profiles" model="ir.ui.view">
        <field name="name">website.form.inherit.upload.profiles</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Upload Profiles" name="upload_profiles" groups="base.group_system">
                    <field name="upload_profile_ids"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
